{
  "name": "@octanejs/next-plugin",
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "description": "Next.js integration for Octane TSRX islands: withOctane() config wrapper and .tsrx compilation for webpack and Turbopack",
  "author": {
    "name": "Dominic Gannaway",
    "email": "dg@domgan.com"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/octanejs/octane.git",
    "directory": "packages/next-plugin-octane"
  },
  "files": [
    "src",
    "types",
    "README.md"
  ],
  "module": "src/index.js",
  "main": "src/index.js",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    }
  },
  "scripts": {
    "test": "cd ../.. && vitest run --project next-plugin"
  },
  "dependencies": {
    "@octanejs/rspack-plugin": "workspace:*"
  },
  "peerDependencies": {
    "next": ">=14.2.0",
    "octane": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:default",
    "octane": "workspace:*",
    "vitest": "catalog:default"
  }
}
